# Database Connection
# Leave empty for local SQLite. For Render production, set to your Postgres connection string.
DATABASE_URL=

# AI Configuration
# Set to 'true' to use Google Gemini API (recommended for free tier, structured output).
# Set to 'false' to use local Hugging Face models (requires more memory).
USE_LLM_API=true

# Get your free key at aistudio.google.com
LLM_API_KEY=your_gemini_api_key_here

# Authentication Secret
# Generate a secure key (e.g., using `openssl rand -hex 32`)
SECRET_KEY=your_secret_key_here

# Admin Default Password (used during initial seed)
ADMIN_PASSWORD=admin123
